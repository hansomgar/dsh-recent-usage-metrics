# Scratch space used while developing or debugging this plugin.
.scratch/

# Throwaway scripts written while investigating a bug. They are dot-prefixed so they never
# resemble the real sources; one of them reached a commit once because nothing excluded it.
.*.cjs
.*.mjs

# Prepared assets for the awesome-dsh-plugin submission PR.
.submission/

# Editor and OS noise.
.vscode/
.idea/
Thumbs.db
desktop.ini

# Node artefacts (the plugin ships plain JS, so none should appear).
node_modules/
npm-debug.log*
pnpm-debug.log*

# Local environment overrides.
.env
.env.local
