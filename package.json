{
  "name": "dsh-recent-usage-metrics",
  "version": "0.1.0",
  "description": "Geek-mode request metrics for DSH: live TTFT / tok-s / token readout in the composer status row, plus a glass history drawer of the last 10 requests.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "client/client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "screenshots.json",
    "assets/screenshot-1.png",
    "assets/screenshot-2.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
